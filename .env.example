# Copy to .env for reference, then set these variables in the shell running Django.
# Django does not load .env automatically.
DJANGO_SECRET_KEY=replace-with-a-local-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Use values for a PostgreSQL database and role provisioned for this project.
POSTGRES_DB=replace-with-project-database
POSTGRES_USER=replace-with-project-user
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
