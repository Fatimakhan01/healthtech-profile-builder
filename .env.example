# Copy to the repository-root .env and replace every placeholder.
# Django settings load this file; never commit the populated .env.
DJANGO_SECRET_KEY=replace-with-a-local-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Use values for a PostgreSQL database and role provisioned for this project.
POSTGRES_DB=replace-with-project-database
POSTGRES_USER=replace-with-project-user
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SHA-256 digests for the verified Week 3 no-show model and metadata.
# Replace both placeholders by running:
# python manage.py refresh_no_show_hashes (from backend/)
NO_SHOW_MODEL_SHA256=replace-with-64-character-model-sha256
NO_SHOW_MODEL_METADATA_SHA256=replace-with-64-character-metadata-sha256


# Local LLM
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:1.5b-instruct
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=2048
OLLAMA_TEMPERATURE=0.1
OLLAMA_MAX_OUTPUT_TOKENS=256